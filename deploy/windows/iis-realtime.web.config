<?xml version="1.0" encoding="utf-8"?>
<!--
  After Hours Burger realtime site on IIS (docs/DEPLOYMENT_WINDOWS.md, "IIS or Plesk instead of
  Caddy"). Copy into the realtime site's (empty) folder as web.config.

  Needs: the WebSocket Protocol feature (Web-WebSockets), URL Rewrite, and Application Request
  Routing with its proxy enabled. Every path (matchmaking, /api, /healthz and the per-room
  WebSockets) goes to the game service, which listens on loopback only.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="After Hours game service" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:2567/{R:0}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="32768" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
