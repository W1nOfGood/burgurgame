<?xml version="1.0" encoding="utf-8"?>
<!--
  After Hours Burger static client on IIS (docs/DEPLOYMENT_WINDOWS.md, "IIS or Plesk instead of
  Caddy"). Copy into the game site's web root as web.config; update.ps1 leaves it in place.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- HTML and the Blender-built art (stable file names) always revalidate; the fingerprinted
           files under /assets are cached for a year (below). -->
      <clientCache cacheControlMode="DisableCache" />
      <!-- Types IIS does not serve by default (it answers 404 for unknown extensions). -->
      <remove fileExtension=".gltf" />
      <mimeMap fileExtension=".gltf" mimeType="model/gltf+json" />
      <remove fileExtension=".bin" />
      <mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <remove fileExtension=".env" />
      <mimeMap fileExtension=".env" mimeType="application/octet-stream" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript; charset=utf-8" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
    </staticContent>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Blender-built art keeps stable file names between builds: always revalidate (ETag), so a
       deployment never mixes new code with stale models, lightmaps or probes. -->
  <location path="art">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" cacheControlCustom="no-cache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
