# Copy to deploy/.env and fill in. Never commit the real file.

# Image tag to build/run.
APP_VERSION=0.1.0

# PostgreSQL (private Compose network only).
POSTGRES_DB=afterhours
POSTGRES_USER=afterhours
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Signs guest credentials. 32+ random characters; changing it signs everyone out.
# Generate with: openssl rand -hex 32
GUEST_TOKEN_SECRET=change-me-to-64-hex-characters

# Exact browser origin(s) of the game website, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://game.example.com

# Realtime origin baked into the static client at build time (scripts/build-client.sh).
VITE_REALTIME_URL=https://realtime.example.com

# Host port the game service binds on 127.0.0.1.
GAME_PORT=2567

# Simultaneous active kitchens this process accepts. Measure before raising.
MAX_ROOMS=20

LOG_LEVEL=info
