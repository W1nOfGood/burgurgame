{
  "name": "after-hours-burger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFTER HOURS BURGER — first-person cooperative burger restaurant simulation",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/data",
    "packages/simulation",
    "packages/protocol",
    "apps/server",
    "apps/client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @ahb/server",
    "dev:client": "npm run dev -w @ahb/client",
    "build": "npm run build:packages && npm run build -w @ahb/server && npm run build -w @ahb/client",
    "build:packages": "tsc -b packages/data packages/simulation packages/protocol",
    "typecheck": "tsc -b packages/data packages/simulation packages/protocol apps/server && npm run typecheck -w @ahb/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate": "tsx --conditions=source apps/server/src/migrate.ts",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
